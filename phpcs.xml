<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 name="Joomla Component Room Booking"
		 xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">
	<description>PSR-12 ruleset for Joomla component development</description>

	<!-- Show progress and sniff codes. -->
	<arg value="ps" />

	<!-- Show colors in CLI output. -->
	<arg name="colors" />

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel"
		 value="8" />

	<!-- Check PHP files only. JavaScript and CSS files are checked separately. -->
	<arg name="extensions"
		 value="php" />

	<arg name="encoding"
		 value="utf-8" />

	<!-- Scan the component source tree. -->
	<file>src</file>

	<!-- Typical folders to exclude. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/media/js/vendor/*</exclude-pattern>
	<exclude-pattern>*/media/css/vendor/*</exclude-pattern>

	<!-- Joomla 4.2+ follows PSR-12. -->
	<rule ref="PSR12">
		<exclude name="Generic.Files.LineLength.TooLong" />
		<exclude name="Generic.Files.LineLength.MaxExceeded" />
		<exclude name="PSR2.Classes.PropertyDeclaration.Underscore" />
	</rule>
</ruleset>